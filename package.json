{
  "name": "whop-wechat-bridge",
  "version": "1.0.0",
  "description": "Bridge Whop chat messages, analyze using AI, archive to SQLite, push to WeChat Work, and show on a premium Web Dashboard",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test_system.js",
    "sync": "node sync.js",
    "pm2:start": "pm2 start server.js --name whop-wechat-bridge",
    "pm2:stop": "pm2 stop whop-wechat-bridge",
    "pm2:restart": "pm2 restart whop-wechat-bridge",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs whop-wechat-bridge"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "longbridge": "latest"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
