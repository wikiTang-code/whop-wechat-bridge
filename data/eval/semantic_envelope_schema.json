{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SemanticEnvelope",
  "description": "大V发言上下文单元的结构化语义抽取 Schema。v1.1 相对 v1.0 仅增加可选字段，旧抽取器仍可用。",
  "type": "object",
  "required": [
    "cu_id",
    "speech_act",
    "actions",
    "claims",
    "strategy_tags",
    "confidence",
    "parse_status"
  ],
  "properties": {
    "cu_id": {
      "type": "string",
      "description": "对应的 Context Unit ID，如 cu_sample_001"
    },
    "schema_version": {
      "type": "string",
      "description": "默认 1.1"
    },
    "speech_act": {
      "type": "string",
      "enum": ["trade_action", "market_view", "risk_control", "qa_guidance", "noise"],
      "description": "主要话语行为。有成交/明确下单优先 trade_action。"
    },
    "actions": {
      "type": "array",
      "description": "明确的交易动作列表，若无则返回空数组",
      "items": {
        "type": "object",
        "required": ["action", "ticker", "price", "fraction"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["BUY", "SELL", "HOLD", "STOP_LOSS", "TAKE_PROFIT"]
          },
          "ticker": { "type": "string", "description": "归一化大写代码。认不出则整条丢弃。" },
          "price": { "type": ["number", "null"] },
          "fraction": {
            "type": "string",
            "description": "原文仓位用语，如 1/6常规仓, 一半, 满仓。没有则空字符串"
          },
          "condition": {
            "type": "string",
            "description": "建议前缀 filled: 或 planned: ，后接触发条件与哪一笔成本"
          },
          "status": {
            "type": "string",
            "enum": ["filled", "planned", "cancelled", "unknown"],
            "description": "可选。v1.1 起使用，旧模型可写在 condition 前缀里"
          },
          "instrument": {
            "type": "string",
            "enum": ["equity", "etf_2x", "option", "crypto", "index", "unknown"]
          },
          "source_message_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "对后市点位、宏观事件或个股的主张。不要重复已经写入 actions 的成交句。",
      "items": {
        "type": "object",
        "required": ["ticker", "statement", "polarity"],
        "properties": {
          "ticker": { "type": "string" },
          "statement": { "type": "string" },
          "polarity": {
            "type": "string",
            "enum": ["bullish", "bearish", "neutral", "conditional"]
          },
          "target_price": { "type": ["number", "null"] }
        }
      }
    },
    "strategy_tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "优先用封闭词表：底仓, 做T, 二次握手, 卡机制, 被动减持, 彩票期权 等"
    },
    "uncertainty": {
      "type": "array",
      "items": { "type": "string" },
      "description": "未交代清晰的盲区。缺标的、只有图片时必须写明，禁止用空话填 actions。"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1.0
    },
    "parse_status": {
      "type": "string",
      "enum": ["ok", "failed", "human_verified"],
      "description": "模型不得输出 human_verified。failed 时 actions/claims/tags 必须为空数组。"
    }
  }
}
