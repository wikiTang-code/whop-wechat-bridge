introspect_*.js
find_*.js
get_*.js
grep_*.js
trigger_*.js
scratch_*.js
auto_refresh_*.js
download_*.js
scan_*.js
dry_*.js

# Temp HTML/TXT files
*.html
!public/index.html
!public/monitoring.html
!data/gex/*.html
*.txt
!tools/gex-sidecar/requirements.txt

# Override ignores for persistent ops scripts
