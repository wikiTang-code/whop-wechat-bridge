logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System Files
.DS_Store
Thumbs.db

# Temp/debug files from reverse engineering
temp_chunks/
scripts/*
!scripts/discovery/
!scripts/watchdog/
!scripts/watchdog/**
scripts/watchdog/.watchdog_state
scripts/watchdog/.watchdog_state


