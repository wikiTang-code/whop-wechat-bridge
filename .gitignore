# Dependencies
node_modules/
jspm_packages/
web_modules/

# Local databases
*.db
*.db-journal
*.db-wal
*.db-shm

# Runtime-generated data (derived from DB / media downloads; not source code)
data/queue_status.json
data/media/zhao/media_manifest.json
data/gex/

# Local Longbridge CLI binary (downloaded by the GEX sidecar)
tools/gex-sidecar/bin/

# GEX sidecar: ignore timed snapshots and the CLI binary; keep v1 sample + charts
data/gex/*
!data/gex/README.md
!data/gex/latest.json
!data/gex/heatseeker_gex.html
!data/gex/gex_matrix_*.html
!data/gex/snapshot_20260905_235029.json
tools/gex-sidecar/bin/
tools/gex-sidecar/__pycache__/
tools/gex-sidecar/open_session_config.json
tools/gex-sidecar/_open_session_task.cmd
data/gex/.skip_open_session

# Sensitive environment variables
.env
.env.production
.env.local
.env.backup*
.env.*.backup
.env.bak

# Logs and debugs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System Files
.DS_Store
Thumbs.db

# Temp/debug files from reverse engineering
temp_chunks/
scripts/*
!scripts/discovery/
!scripts/watchdog/
!scripts/watchdog/**
!scripts/cleanup_gemini_api_cloud.js
!scripts/offline_queue_worker.js
!scripts/run_offline_asset_sync.js
!scripts/check_persona_queue_status.js
!scripts/inspect_stuck_persona_task.js
scripts/watchdog/.watchdog_state
scripts/watchdog/.*state*
data/runtime/


# One-off debug/test scripts
/test_*.js
!test/
!test/**
query_*.js
search_*.js
fetch_*.js
inspect_*.js
run_*.js
check_*.js
decode_*.js
extract_*.js
dump_*.js
parse_*.js
print_*.js
