# GEX sidecar — Windows 本机，不要配到 GCP。
# 复制需要的行到仓库根目录 .env，或在跑脚本前 $env:NAME='...'

# 长桥 CLI 行情区（指数现货 .SPX.US 等）。token 在 ~/.longbridge，不写在这里。
LONGBRIDGE_REGION=global

# 富途 OpenD 行情网关（默认本机 11111）
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111

# 跟单交易仍用根目录 .env 里的长桥 OpenAPI 三件套（本 sidecar 不读取）：
# LONGBRIDGE_APP_KEY=
# LONGBRIDGE_APP_SECRET=
# LONGBRIDGE_ACCESS_TOKEN=
